{
  "type": "object",
  "properties": {
    "doc_id": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "equations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "equation_number": {
            "type": "string"
          },
          "form": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string"
                },
                "units": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "input",
                    "output",
                    "parameter",
                    "constant",
                    "unknown"
                  ]
                }
              },
              "required": [
                "symbol",
                "meaning"
              ]
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validity": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "page": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "extraction_note": {
            "type": "string"
          },
          "assumption_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Explicit same-document grounded assumption statements whose scope was reviewed for this equation."
          },
          "enrichment_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Parser candidates inspected against the original PDF by a named F/A reviewer; candidate document, page and current source fingerprint must match. Rejected candidates are correction history only."
          },
          "supersedes_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Explicit reviewed replacement of an incomplete same-document, same-number, same-source-hash transcription; history is retained."
          },
          "corrects_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Raw parser notation explicitly corrected against the original PDF by a named F/A reviewer; candidate document, page and current source fingerprint must match. Rejected raw candidates remain traceable without becoming source support."
          }
        },
        "required": [
          "label",
          "form",
          "page",
          "quote",
          "confidence"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_type": {
            "type": "string",
            "enum": [
              "definition",
              "theoretical",
              "empirical",
              "methodological",
              "comparative",
              "assumption",
              "constraint",
              "recommendation",
              "validity_statement",
              "design_criterion",
              "derived_result",
              "benchmark_result"
            ]
          },
          "subject": {
            "type": "string"
          },
          "predicate": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "qualifiers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "page": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "enrichment_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Parser candidates inspected against the original PDF by a named F/A reviewer; candidate document, page and current source fingerprint must match. Rejected candidates are correction history only."
          },
          "corrects_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Raw parser notation explicitly corrected against the original PDF by a named F/A reviewer; candidate document, page and current source fingerprint must match. Rejected raw candidates remain traceable without becoming source support."
          }
        },
        "required": [
          "claim_type",
          "subject",
          "predicate",
          "object",
          "statement",
          "page",
          "quote",
          "confidence"
        ]
      }
    },
    "validity_statements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string"
          },
          "applies_to": {
            "type": "string"
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "variable": {
                  "type": "string"
                },
                "lower": {
                  "type": "string"
                },
                "upper": {
                  "type": "string"
                },
                "units": {
                  "type": "string"
                }
              },
              "required": [
                "variable"
              ]
            }
          },
          "page": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          },
          "enrichment_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Parser candidates inspected against the original PDF by a named F/A reviewer; candidate document, page and current source fingerprint must match. Rejected candidates are correction history only."
          },
          "corrects_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Raw parser notation explicitly corrected against the original PDF by a named F/A reviewer; candidate document, page and current source fingerprint must match. Rejected raw candidates remain traceable without becoming source support."
          }
        },
        "required": [
          "statement",
          "applies_to",
          "page",
          "quote"
        ]
      }
    },
    "empirical_constants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "units": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          },
          "enrichment_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Parser candidates inspected against the original PDF by a named F/A reviewer; candidate document, page and current source fingerprint must match. Rejected candidates are correction history only."
          },
          "corrects_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Raw parser notation explicitly corrected against the original PDF by a named F/A reviewer; candidate document, page and current source fingerprint must match. Rejected raw candidates remain traceable without becoming source support."
          }
        },
        "required": [
          "name",
          "value",
          "page",
          "quote"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          },
          "enrichment_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Parser candidates inspected against the original PDF by a named F/A reviewer; candidate document, page and current source fingerprint must match. Rejected candidates are correction history only."
          },
          "corrects_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Raw parser notation explicitly corrected against the original PDF by a named F/A reviewer; candidate document, page and current source fingerprint must match. Rejected raw candidates remain traceable without becoming source support."
          }
        },
        "required": [
          "statement",
          "page",
          "quote"
        ]
      }
    },
    "supports_model": {
      "type": "object",
      "properties": {
        "found": {
          "type": "boolean"
        },
        "equation_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comparison_equation_labels": {
          "description": "Source formulations explicitly compared with a different implementation; CITES only, never IMPLEMENTS.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mismatch_notes": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "NOT_FOUND_IN_SOURCE",
            "SOURCE_UNREADABLE"
          ]
        }
      },
      "required": [
        "found",
        "state"
      ]
    },
    "notes": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "description": "Who transcribed/reviewed this result against the original PDF page. The same role can never later count as the independent verifier of these objects.",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "F",
            "A"
          ]
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "model"
      ]
    },
    "model_review": {
      "type": "object",
      "description": "Structured model-versus-source comparison (Section 17 method). Bound to source and exact implementation-definition fingerprints; never a physical-validation claim.",
      "properties": {
        "fidelity": {
          "type": "string",
          "enum": [
            "EXACT",
            "EQUIVALENT",
            "CONDITIONALLY_EQUIVALENT",
            "SUPPORTED_APPROXIMATION",
            "REPOSITORY_EXTENSION",
            "DIFFERENT_FORMULA",
            "BAD_ATTRIBUTION",
            "INSUFFICIENT_EVIDENCE",
            "UNRESOLVED"
          ]
        },
        "implementation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "symbol": {
                "type": "string",
                "description": "exact qualified definition name inside the file"
              }
            },
            "required": [
              "file",
              "symbol"
            ]
          }
        },
        "source_pages": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "equation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comparison": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "constants": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "citation_vs_support": {
          "type": "string"
        },
        "software_verification": {
          "type": "string"
        },
        "physical_validation": {
          "type": "string"
        },
        "execution_reach": {
          "type": "string"
        },
        "sensitivity": {
          "type": "string"
        },
        "physics_change_required": {
          "type": "boolean"
        },
        "physics_finding": {
          "type": "string"
        },
        "remaining_uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "fidelity",
        "implementation",
        "source_pages"
      ]
    }
  },
  "required": [
    "doc_id",
    "target",
    "equations",
    "claims",
    "source_sha256"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LREKit literature extraction result"
}

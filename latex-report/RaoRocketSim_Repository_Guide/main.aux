\@writefile{lof}{\contentsline {figure}{\numberline {12.1}{\ignorespaces Half-cutaway of the 13 kN LOX/RP-1 thrust chamber of build 13kn\_sl\_fast: GRCop-84 liner (orange, 0.6 mm hot wall) inside the Inconel 718 jacket (blue, 0.5 mm), with the injector-end flange (outer diameter 172.7 mm). Rendered for this guide from wall.stl and jacket.stl with matplotlib painter's-algorithm shading. wall.stl is the liner base only, so the 194 coolant channels are not drawn.}}{177}{figure.caption.25}\protected@file@percent }
\newlabel{fig:b01}{{12.1}{177}{Half-cutaway of the 13 kN LOX/RP-1 thrust chamber of build 13kn\_sl\_fast: GRCop-84 liner (orange, 0.6 mm hot wall) inside the Inconel 718 jacket (blue, 0.5 mm), with the injector-end flange (outer diameter 172.7 mm). Rendered for this guide from wall.stl and jacket.stl with matplotlib painter's-algorithm shading. wall.stl is the liner base only, so the 194 coolant channels are not drawn}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.2}{\ignorespaces Thrust-chamber contour from the converged rao-bvp solve of 13kn\_rao\_bvp\_flowfield (17 July): $\varepsilon = 4.524$, 80\,\% bell, $C_F = 1.441$. Injector face at $x \approx -355$ mm, throat at $x = 0$, exit at $x \approx 104$ mm.}}{178}{figure.caption.26}\protected@file@percent }
\newlabel{fig:b02}{{12.2}{178}{Thrust-chamber contour from the converged rao-bvp solve of 13kn\_rao\_bvp\_flowfield (17 July): $\varepsilon = 4.524$, 80\,\% bell, $C_F = 1.441$. Injector face at $x \approx -355$ mm, throat at $x = 0$, exit at $x \approx 104$ mm}{figure.caption.26}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {12.2.2}Supersonic flow field and the Rao construction}{178}{subsection.12.2.2}\protected@file@percent }
\newlabel{sec:builds-pic-flow}{{12.2.2}{178}{Supersonic flow field and the Rao construction}{subsection.12.2.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.3}{\ignorespaces Steady supersonic method-of-characteristics field over the converged bell: Mach number, $p/p_0$, flow angle and static temperature with streamlines. The design and the resolved area-averaged exit Mach numbers are both 2.78. The blank wedge at the throat is the transonic core upstream of the first supersonic characteristic, where no state is computed.}}{179}{figure.caption.27}\protected@file@percent }
\newlabel{fig:b03}{{12.3}{179}{Steady supersonic method-of-characteristics field over the converged bell: Mach number, $p/p_0$, flow angle and static temperature with streamlines. The design and the resolved area-averaged exit Mach numbers are both 2.78. The blank wedge at the throat is the transonic core upstream of the first supersonic characteristic, where no state is computed}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.4}{\ignorespaces Rao B-D-E optimum-thrust topology: throat-arc wall 0--B; the last kernel right-running characteristic (RRC) from B to the axis, of which BD is the upper part; the DE control surface, a left-running characteristic (LRC); and the wall streamline B--E. The mass flows across BD and DE agree to a relative difference of $2.7\times 10^{-9}$.}}{179}{figure.caption.28}\protected@file@percent }
\newlabel{fig:b04}{{12.4}{179}{Rao B-D-E optimum-thrust topology: throat-arc wall 0--B; the last kernel right-running characteristic (RRC) from B to the axis, of which BD is the upper part; the DE control surface, a left-running characteristic (LRC); and the wall streamline B--E. The mass flows across BD and DE agree to a relative difference of $2.7\times 10^{-9}$}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.5}{\ignorespaces Throat-kernel MOC expansion fan with 90 RRCs, $\theta _B \approx 22.58^\circ $, coloured by Mach number. The axis Mach number of about 4.2 is reached near $x \approx 0.22$ m, downstream of the 0.104 m exit plane, so that part of the kernel belongs to the construction and not to the nozzle flow.}}{180}{figure.caption.29}\protected@file@percent }
\newlabel{fig:b05}{{12.5}{180}{Throat-kernel MOC expansion fan with 90 RRCs, $\theta _B \approx 22.58^\circ $, coloured by Mach number. The axis Mach number of about 4.2 is reached near $x \approx 0.22$ m, downstream of the 0.104 m exit plane, so that part of the kernel belongs to the construction and not to the nozzle flow}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.6}{\ignorespaces BDE characteristic net with 23 rows. Left: the physical B-D-E region, of which only the part below the wall streamline lies inside the nozzle. Right: the auxiliary post-DE continuation, stopped before a downstream caustic.}}{181}{figure.caption.30}\protected@file@percent }
\newlabel{fig:b06}{{12.6}{181}{BDE characteristic net with 23 rows. Left: the physical B-D-E region, of which only the part below the wall streamline lies inside the nozzle. Right: the auxiliary post-DE continuation, stopped before a downstream caustic}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.7}{\ignorespaces BDE flow and conservation diagnostics. Top: Mach number, pressure and flow angle over the net. Bottom: characteristic compatibility residuals (RMS $2.0\times 10^{-5}$ deg on C$^-$, $2.7\times 10^{-4}$ deg on C$^+$), axial mass-flow error relative to the throat (maximum 0.14\,\%, negative at every cut) and the post-DE prefix, with no RRC or LRC crossings.}}{181}{figure.caption.31}\protected@file@percent }
\newlabel{fig:b07}{{12.7}{181}{BDE flow and conservation diagnostics. Top: Mach number, pressure and flow angle over the net. Bottom: characteristic compatibility residuals (RMS $2.0\times 10^{-5}$ deg on C$^-$, $2.7\times 10^{-4}$ deg on C$^+$), axial mass-flow error relative to the throat (maximum 0.14\,\%, negative at every cut) and the post-DE prefix, with no RRC or LRC crossings}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.8}{\ignorespaces BDE numerical integrity audit: 100\,\% of characteristic links compatible to within 0.002 deg; 0 of 528 cells with zero or negative area; axis condition $\theta = 0$ on the kernel RRCs; 99th-percentile neighbour Mach jump 0.052 (maximum 0.062).}}{182}{figure.caption.32}\protected@file@percent }
\newlabel{fig:b08}{{12.8}{182}{BDE numerical integrity audit: 100\,\% of characteristic links compatible to within 0.002 deg; 0 of 528 cells with zero or negative area; axis condition $\theta = 0$ on the kernel RRCs; 99th-percentile neighbour Mach jump 0.052 (maximum 0.062)}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.9}{\ignorespaces Schmucker flow-separation screen on the contour, using constant-$\gamma $ quasi-one-dimensional wall pressure at $P_c = 3.0$ MPa: the nozzle flows full at ambient pressures of 101, 50, 20 and 5 kPa.}}{182}{figure.caption.33}\protected@file@percent }
\newlabel{fig:b09}{{12.9}{182}{Schmucker flow-separation screen on the contour, using constant-$\gamma $ quasi-one-dimensional wall pressure at $P_c = 3.0$ MPa: the nozzle flows full at ambient pressures of 101, 50, 20 and 5 kPa}{figure.caption.33}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {12.2.3}Regenerative cooling and liner structure}{182}{subsection.12.2.3}\protected@file@percent }
\newlabel{sec:builds-pic-regen}{{12.2.3}{182}{Regenerative cooling and liner structure}{subsection.12.2.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.10}{\ignorespaces Regenerative wall of 13kn\_sl\_fast: Bartz convective heat flux (peak 25.4 MW/m$^2$ at the throat) and the gas-side wall, coolant-side wall and coolant bulk temperatures, plotted against the 1000 K gas-side limit and the 700 K RP-1 coking line (SP-8087). The coolant enters at the nozzle exit and leaves at the injector end.}}{183}{figure.caption.34}\protected@file@percent }
